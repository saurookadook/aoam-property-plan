{
    /**
     * The strict-mode beachhead.
     *
     * `tsconfig.common.json` leaves `strict` off, and turning it on repo-wide
     * would bury Phase 4's own errors under pre-existing ones. So the files
     * added or rewritten in Phase 4 are type-checked strictly here, and the
     * `include` list grows as the rest of the app is brought up to standard.
     *
     * Note that `tsc` reports errors in *imported* files as well as `include`d
     * ones, so adding a file here also holds its imports to `strict` at the
     * points this code touches them.
     */
    "extends": "./tsconfig.common.json",
    "compilerOptions": {
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.strict.tsbuildinfo",
        "jsx": "react-jsx",
        "lib": [
            "ES2023",
            "DOM",
            "DOM.Iterable"
        ],
        "strict": true,
        "types": [
            "node",
            "vitest",
            "@testing-library/jest-dom",
            "vite/client"
        ]
    },
    "include": [
        "src/types/*.d.ts",
        "src/constants/property.ts",
        "src/utils/unwrapEnvelope.ts",
        "src/utils/__tests__/unwrapEnvelope.test.ts",
        "src/common/utils/charts.ts",
        "src/common/utils/currency.ts",
        "src/common/utils/dataConfidence.ts",
        "src/common/utils/investmentFit.ts",
        "src/common/utils/metricThresholds.ts",
        "src/common/utils/propertyAnalysis.ts",
        "src/common/utils/__tests__/*.test.ts",
        "src/providers/CurrencyProvider.tsx",
        "src/pages/markets/MarketsList/index.tsx",
        "src/pages/markets/MarketsList/index.test.tsx",
        "src/pages/markets/MarketsList/utils/sortMarkets.ts",
        "src/pages/markets/MarketsList/utils/__tests__/*.test.ts",
        "src/pages/markets/MarketsList/components/MarketsListData/index.tsx",
        "src/pages/markets/MarketsList/components/MarketCard/index.tsx",
        "src/pages/markets/MarketsList/components/MarketCard/BudgetIndicator/index.tsx",
        "src/pages/markets/MarketsList/components/FitScoreBadge/index.tsx",
        "src/pages/markets/MarketsList/components/MarketSortControls/index.tsx",
        "src/pages/markets/MarketsList/components/ColombiaMap/index.tsx",
        "src/common/hooks/useExchangeRateQuery.ts",
        "src/app/browserRouter.tsx",
        "src/pages/properties/queries.ts",
        "src/pages/properties/PropertiesList/index.tsx",
        "src/pages/properties/PropertiesList/index.test.tsx",
        "src/pages/properties/PropertiesList/components/PropertyRow/index.tsx",
        "src/pages/properties/PropertyCreate/index.tsx",
        "src/pages/properties/PropertyCreate/index.test.tsx",
        "src/pages/properties/PropertyCreate/utils.ts",
        "src/pages/properties/PropertyCreate/__tests__/*.test.ts",
        "src/pages/properties/PropertyCreate/components/ManualEntryPanel/index.tsx",
        "src/pages/properties/PropertyCreate/components/PropertyLocationPicker/index.tsx",
        "src/pages/properties/PropertyOverview/index.tsx",
        "src/pages/properties/PropertyOverview/index.test.tsx",
        "src/pages/properties/PropertyOverview/utils.ts",
        "src/pages/properties/PropertyOverview/constants.ts",
        "src/pages/properties/PropertyOverview/__tests__/*.test.ts",
        "src/pages/properties/PropertyOverview/components/AssumptionsPanel/index.tsx",
        "src/pages/properties/PropertyOverview/components/DataConfidenceBanner/index.tsx",
        "src/pages/properties/PropertyOverview/components/ExpenseBreakdownCard/index.tsx",
        "src/pages/properties/PropertyOverview/components/MetricGrid/index.tsx",
        "src/pages/properties/PropertyOverview/components/PropertyCompsTable/index.tsx",
        "src/pages/properties/PropertyOverview/components/PropertyHeaderCard/index.tsx",
        "src/pages/properties/PropertyOverview/components/RevenueComparisonRow/index.tsx",
        "src/pages/properties/PropertyOverview/components/SeasonalityChart/index.tsx",
        "src/pages/properties/PropertyOverview/components/SensitivityTable/index.tsx"
    ]
}
