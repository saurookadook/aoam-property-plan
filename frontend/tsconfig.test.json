{
  "extends": "./tsconfig.common.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    /**
     * `tsc` reports errors in imported files too, not just `include`d ones, and
     * every page test imports a component that side-effect-imports a `.scss`
     * file. Without vite's ambient declarations here those imports are errors in
     * the test project even though they type-check fine in the app project.
     */
    "types": [
      "vitest",
      "@testing-library/jest-dom",
      "vite/client"
    ]
  },
  "include": [
    "src/__mocks__/**/*.ts",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/utils/testing/*.ts",
    "src/**/utils/testing/*.tsx",
    "src/**/testUtils.ts",
    "vitest.setup.ts",
    "vitest.shims.d.ts"
  ]
}
