{
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnType": false, // required
    "editor.formatOnPaste": false, // optional
    "editor.formatOnSave": true, // optional
    "editor.formatOnSaveMode": "file", // required to format on save
    // "files.autoSave": "onFocusChange", // optional but recommended
    "vs-code-prettier-eslint.prettierLast": true, // set as "true" to run 'prettier' last not first
    "editor.tabSize": 2,
    "path-autocomplete.pathMappings": {
        // "__mocks__": "app/src/__mocks__",
        // "client": "app/src/client",
        // "server": "app/src/server",
        // "types": "app/src/types"
    },
    "prettier.requireConfig": true,
    "prettier.resolveGlobalModules": true,
    "prettier.configPath": "./frontend/.prettierrc.js",
    "[typescriptreact]": {
        "editor.tabSize": 2
    },
    // ------ CSS
    "[css]": {
        "editor.tabSize": 2
    },
    "[scss]": {
        "editor.tabSize": 2
    },
    // ------ Python
    "[python]": {
        "editor.tabSize": 4
    },
    "flake8.args": [
        "--max-line-length=120",
        "--per-file-ignores='__init__.py: F401'"
    ],
    "python.analysis.extraPaths": [
        "backend/.venv/lib/python3.12/site-packages",
    ],
    "[sql]": {
        "editor.formatOnSave": false
    },
    // ------ JSON
    "json.schemaDownload.trustedDomains": {
        "https://schemastore.azurewebsites.net/": true,
        "https://raw.githubusercontent.com/microsoft/vscode/": true,
        "https://raw.githubusercontent.com/devcontainers/spec/": true,
        "https://www.schemastore.org/": true,
        "https://json.schemastore.org/": true,
        "https://json-schema.org/": true,
        "https://developer.microsoft.com/json-schemas/": true,
        "https://railway.com/railway.schema.json": true
    },
    "[json]": {
        "editor.tabSize": 4
    },
    "[jsonc]": {
        "editor.tabSize": 4
    },
    "[yaml]": {
        "editor.detectIndentation": false,
        "editor.tabSize": 2
    },
    "[yml]": {
        "editor.detectIndentation": false,
        "editor.tabSize": 2
    }
}
